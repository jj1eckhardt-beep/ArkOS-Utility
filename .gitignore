# ==========================================
# 1. BOT & ACCIDENTAL LEAK PREVENTION
# ==========================================
# Ignore local environment variables & config files containing keys
.env
*.env
config.json
secrets.*
credentials/

# Ignore local system paths that leak user usernames/folder structures
*.suo
*.user
*.sln.docstates

# ==========================================
# 2. LOCAL DEV & SCRATCH FILES
# ==========================================
*scratch*
*.tmp
*.log
*.bak
*.old

# ==========================================
# 3. WINDOWS OS CLEANUP
# ==========================================
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# ==========================================
# 4. BUILD / OUTPUT ARTIFACTS
# ==========================================
bin/
obj/
dist/
out/

# ==========================================
# 5. PROJECT-SPECIFIC WORKING FOLDERS
# ==========================================
.Archive/
.cline/
AI_Working/

# ==========================================
# 6. OPTIONAL - Generated reports
# ==========================================
SDCard_*.txt
SDCard_Benchmark.csv
